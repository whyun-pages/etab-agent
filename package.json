{
  "name": "@whyun/etab-agent",
  "version": "0.1.2",
  "description": "说一句中文要什么表，模型给出工作簿，代码校验后落笔。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyun-pages/etab-agent.git"
  },
  "homepage": "https://github.com/whyun-pages/etab-agent#readme",
  "bugs": {
    "url": "https://github.com/whyun-pages/etab-agent/issues"
  },
  "type": "commonjs",
  "bin": {
    "etab": ".build/js/cli.js"
  },
  "files": [
    ".build/js/",
    "public/"
  ],
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "prepack": "tsc",
    "prestart": "tsc",
    "start": "node .build/js/server.js",
    "start:dev": "tsx server.ts",
    "predesktop": "tsc",
    "desktop": "node .build/js/desktop.js",
    "desktop:dev": "tsx desktop.ts",
    "typecheck": "tsc --noEmit",
    "build:js": "tsc",
    "check:imports": "node .verify/check-imports.cjs",
    "preverify:live": "node tools/build-exe.js",
    "verify:live": "node --require ./tools/dev-resolve.js .verify/live-totals.js && node --require ./tools/dev-resolve.js .verify/live-controls.js && node --require ./tools/dev-resolve.js .verify/live-attach.js && node .verify/live-delete-exe.js && node .verify/live-attach-exe.js",
    "test": "node .verify/check-imports.cjs && node --require ./tools/dev-resolve.js --test \"tests/*.test.js\"",
    "bundle": "node tools/verify-bundle.js",
    "build": "node tools/build-exe.js"
  },
  "devDependencies": {
    "@types/koa": "3.0.3",
    "@types/koa__multer": "2.0.8",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@koa/bodyparser": "6.1.0",
    "@koa/multer": "4.0.0",
    "@koa/router": "15.7.0",
    "koa": "3.2.1",
    "multer": "2.4.0"
  }
}
