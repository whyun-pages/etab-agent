# Build output — regenerate with: node tools/build-exe.js
dist/
.build/

# Development-only tooling (postject for the SEA build)
node_modules/

# Runtime state. Sessions, attachments and model settings are per-user data; a
# packaged build keeps them under %APPDATA%\ETabAgent instead.
data/

# Verification scratch
.verify/out/

# Working safety net. Backups written before a destructive edit (a rename, a
# rewrite) land here. They are insurance for the minutes a change is in flight,
# not history worth keeping — and git already holds the durable copy.
.Trash/

# Editor / OS
# Editor settings stay local, except the two that make Biome format on save.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
*.log

# Eval runs against a real model (evals/run.js): replies, ops and result specs
evals/out/
