{
  // `pnpm typecheck` runs this after the root config; CI runs both. The suite
  // itself runs through tsx, which strips types without checking them, so
  // this is the only place the tests are type-checked.
  //
  // Strict, like the root config, with two exceptions:
  //
  // - noImplicitAny is off. A callback parameter in a fixture or a fake
  //   transport (`(req, res) => ...`, `(m) => m.role`) would otherwise need
  //   an annotation that says nothing the call site does not.
  // - useUnknownInCatchVariables is off. A test's catch reads `err.message`
  //   or `err.code` to assert on it; narrowing first would be ceremony.
  //
  // The rest of strict stays on, and it has to: the tests pull src/ into this
  // program, and src/ is only correct under strictNullChecks. With strict off,
  // `null` and `undefined` vanish from every type, and src/ itself stops
  // type-checking.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["**/*.ts"]
}
