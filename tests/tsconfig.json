{
  // For the editor and for an opt-in `tsc -p tests`. The suite itself runs
  // through tsx, which strips types without checking them, so nothing here
  // gates `pnpm test`.
  //
  // Not strict, unlike the root config: these files were JavaScript until the
  // move to src/, and typing 6,700 lines of fixtures and fake transports is
  // its own piece of work. Without this file the editor would still resolve
  // `../src/x.ts`, but flag every import for its `.ts` extension.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "strict": false
  },
  "include": ["**/*.ts"]
}
